# Backend environment variables
# Copy to .env and fill in values

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sol_auction
SECRET_KEY=supersecretkey_change_in_prod
GOOGLE_CLIENT_ID=

# Solana RPC (devnet by default)
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- DEV / LOCAL ONLY — never set in production ---
# Enables /api/auth/dev-login and MockAnchorChainClient (no real RPC calls)
DEV_AUTH_BYPASS=true
# Base58 private keypair for local transaction signing (anchor tests / dev scripts)
DEV_SIGNER_KEYPAIR=
